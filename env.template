APP_PORT=8080
MCP_TRANSPORT=sse

# Documentación Swagger en /swagger/ y /openapi.yaml. Valores: true/false (por defecto: true).
SWAGGER_ENABLED=true

# Token para clientes MCP en modo SSE (header: Authorization: Bearer <valor>). Dejar vacío solo en desarrollo local.
MCP_API_KEY=

# REST API en /api/* (Swagger y MCP no usan esta configuración).
# Si JWT_SECRET está vacío, la API queda sin autenticación (solo desarrollo).

# JWT compartido entre las APIs de la empresa (header: Authorization: Bearer <jwt>).
# El token debe estar firmado con HS256 usando este mismo secreto y llevar claim "exp".
JWT_SECRET=

# Credenciales API TowerCoverage (GetSiteList + LinkPathAPI)
TOWER_API_ACCOUNT=
TOWER_API_KEY=tu_api_key

# Límite de llamadas LinkPathAPI en paralelo (también coords /full y Playwright legado). Por defecto: 5
TOWER_COVERAGE_CONCURRENCY=5

# Redis local/Docker: solo cache de GetSiteList (en compose se fuerza redis:6379).
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis remoto: cache de coberturas procesadas (proximidad). Obligatorio para reutilizar resultados.
COVERAGE_REDIS_HOST=tu-servidor-redis.ejemplo.com
COVERAGE_REDIS_PORT=6379
COVERAGE_REDIS_PASSWORD=
COVERAGE_REDIS_DB=0
# Radio en metros: si hay una cobertura full previa dentro de este radio, se reutiliza (API light/full y MCP).
COVERAGE_CACHE_RADIUS_M=25

# DB TORRES
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=tu_password_seguro
DB_NAME=intermapper_db
