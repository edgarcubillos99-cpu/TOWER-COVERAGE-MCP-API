APP_PORT=8080
MCP_TRANSPORT=sse

# Documentación Swagger en /swagger/ y /openapi.yaml. Valores: true/false (por defecto: true).
SWAGGER_ENABLED=true

# Token para clientes MCP en modo SSE (header: Authorization: Bearer <valor>). Dejar vacío solo en desarrollo local.
MCP_API_KEY=

# REST API en /api/* (Swagger y MCP no usan esta configuración).
# Si JWT_SECRET está vacío, la API queda sin autenticación (solo desarrollo).

# JWT compartido entre las APIs de la empresa (header: Authorization: Bearer <jwt>).
# El token debe estar firmado con HS256 usando este mismo secreto y llevar claim "exp".
JWT_SECRET=

# Credenciales tower_coverage
TOWER_USERNAME=tu_correo@ejemplo.com
TOWER_PASSWORD=tu_contraseña_segura

# Consultas de cobertura en paralelo (API, MCP y Playwright). Por defecto: 5.
TOWER_COVERAGE_CONCURRENCY=5

# DB TORRES
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=tu_password_seguro
DB_NAME=intermapper_db

# REDIS (caché de torres/APs)
# Si REDIS_ADDR está vacío, la caché queda deshabilitada y todo se consulta en MySQL.
# Al arrancar, tras conectar a MySQL, se precargan todas las torres y sus APs en Redis.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# TTL de las claves en minutos. 0 = sin expiración (la caché vive hasta el próximo arranque/warm).
REDIS_TTL_MINUTES=0